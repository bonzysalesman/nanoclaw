#!/usr/bin/env bash
#
# PDF Reader Skill for NanoClaw
# Extracts text and layout from PDF files using poppler-utils.
#
# Usage:
#   pdf-reader extract <file.pdf>
#

COMMAND=$1
FILE=$2

if [ -z "$FILE" ]; then
  echo "Usage: pdf-reader extract <file.pdf>"
  exit 1
fi

if [ ! -f "$FILE" ]; then
  echo "Error: File not found: $FILE"
  exit 1
fi

case "$COMMAND" in
  extract)
    echo "--- PDF EXTRACTION: $FILE ---"
    # -layout preserves the visual structure (tables, columns)
    # -eol unix ensures clean line endings
    pdftotext -layout -eol unix "$FILE" -
    echo "--- END EXTRACTION ---"
    ;;
  *)
    echo "Unknown command: $COMMAND"
    exit 1
    ;;
esac
